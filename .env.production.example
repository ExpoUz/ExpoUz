# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=expouz
POSTGRES_USER=swu
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── API public URL (used by admin web) ───────────────────────────────────────
PUBLIC_API_URL=https://api.expouz.uz/v1

# ─── SIMPLE_MODE (core-loop kill switch) ──────────────────────────────────────
# Default ON when unset — collapses tma/pitch-portal/admin to the booking loop and
# hides non-core features (skill levels, leaderboard, formation, player discovery,
# wallet, CRM, insights, broadcasts, organizations, activity feed, chat groups).
# Set to "false" in each frontend's build env to restore the full feature set.
# NEXT_PUBLIC_SIMPLE_MODE=false

# ─── SMS (Eskiz) ──────────────────────────────────────────────────────────────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# ─── Payment Gateways ─────────────────────────────────────────────────────────
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=
# Set to: https://app.expouz.uz  (the Mini App URL)
TELEGRAM_MINI_APP_URL=https://app.expouz.uz

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console (OAuth 2.0 credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
SENTRY_DSN=
