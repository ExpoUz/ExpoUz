DATABASE_URL=postgresql://dev:dev@localhost:5432/expouz
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
# ─── Wallet (launch model) ───────────────────────────────────────────────────
# The wallet is the single internal currency. These bonuses fund it without a
# gateway so users can transact immediately during the merchant-account-pending
# launch period. Amounts in UZS.
WELCOME_BONUS_AMOUNT=50000
REFERRAL_BONUS_AMOUNT=50000

# ─── Payment gateways (built, disabled until merchant accounts approved) ──────
# Keep false until a registered business entity + approved merchant accounts
# exist. Flip to true (and fill the keys below) to enable online top-ups.
# See PAYMENTS_GO_LIVE.md.
PAYMENT_GATEWAYS_ENABLED=false
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_WEBHOOK_IP_WHITELIST=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://expouz.uz
SENTRY_DSN=
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=
