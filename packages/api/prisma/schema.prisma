generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USER & AUTH ============
model User {
  id               String     @id @default(cuid())
  phone            String     @unique
  email            String?    @unique
  firstName        String
  lastName         String
  avatarUrl        String?
  dateOfBirth      DateTime?
  gender           Gender     @default(MALE)
  bio              String?
  reliabilityScore Float      @default(100.0)
  eloRating        Int        @default(1000)
  skillLevel       SkillLevel @default(AMATEUR)
  role             UserRole   @default(PLAYER)
  city             String     @default("Tashkent")
  district         String?
  isVerified       Boolean    @default(false)
  telegramId       String?    @unique
  telegramUsername String?
  credit           Decimal    @default(0) @db.Decimal(12, 2)
  referralCode     String     @unique @default(cuid())
  referredBy       String?
  notifPush        Boolean    @default(true)
  notifSms         Boolean    @default(true)
  notifTelegram    Boolean    @default(true)
  isBanned         Boolean    @default(false)
  bannedAt         DateTime?
  bannedReason     String?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  hostMatches        Match[]              @relation("HostMatches")
  bookings           Booking[]
  transactions       Transaction[]
  ratingsGiven       PlayerRating[]       @relation("RatingsGiven")
  ratingsReceived    PlayerRating[]       @relation("RatingsReceived")
  ownedPitches       Pitch[]              @relation("PitchOwner")
  messages           Message[]
  notifications      Notification[]
  preferredPositions UserPosition[]
  conversationMemberships ConversationMember[]
  refreshTokens      RefreshToken[]
}

enum Gender     { MALE FEMALE OTHER PREFER_NOT_TO_SAY }
enum UserRole   { PLAYER PITCH_OWNER ADMIN SUPER_ADMIN }
enum SkillLevel { BEGINNER AMATEUR PRO }

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([phone])
}

// ============ PITCH / STADIUM ============
model Pitch {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation("PitchOwner", fields: [ownerId], references: [id])
  name         String
  description  String?
  addressLine  String
  district     String
  city         String      @default("Tashkent")
  lat          Float
  lng          Float
  hourlyRate   Decimal     @db.Decimal(12, 2)
  photos       String[]
  amenities    Amenity[]
  surfaceType  SurfaceType @default(ARTIFICIAL)
  pitchSize    PitchSize   @default(SEVEN_A_SIDE)
  isIndoor     Boolean     @default(false)
  isVerified   Boolean     @default(false)
  isActive     Boolean     @default(true)
  noMetalStuds Boolean     @default(false)
  commission   Float       @default(0.10)
  rejectionReason String?
  createdAt    DateTime    @default(now())
  matches      Match[]
  followers    PitchFollower[]
}

enum SurfaceType { NATURAL ARTIFICIAL FUTSAL INDOOR_TURF }
enum PitchSize   { FIVE_A_SIDE SEVEN_A_SIDE ELEVEN_A_SIDE }

model Amenity {
  id      String      @id @default(cuid())
  pitchId String
  pitch   Pitch       @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  type    AmenityType
}
enum AmenityType { BATHROOM PARKING WATER_FOUNTAIN CHANGING_ROOM CAFE SECURITY LIGHTS }

// ============ MATCH ============
model Match {
  id                        String      @id @default(cuid())
  pitchId                   String
  pitch                     Pitch       @relation(fields: [pitchId], references: [id])
  hostId                    String
  host                      User        @relation("HostMatches", fields: [hostId], references: [id])
  title                     String
  sport                     Sport       @default(FOOTBALL)
  format                    String
  startTime                 DateTime
  durationMinutes           Int         @default(60)
  maxPlayers                Int
  minPlayers                Int         @default(10)
  currentPlayers            Int         @default(0)
  pricePerPlayer            Decimal     @db.Decimal(12, 2)
  status                    MatchStatus @default(OPEN)
  isCoEd                    Boolean     @default(true)
  skillFilter               SkillLevel?
  description               String?
  cancellationDeadlineHours Int         @default(2)
  formation                 String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  bookings      Booking[]
  positions     MatchPosition[]
  ratings       PlayerRating[]
  notifications Notification[]
}

enum Sport       { FOOTBALL BASKETBALL VOLLEYBALL TENNIS BADMINTON }
enum MatchStatus { OPEN FULL CONFIRMED IN_PROGRESS COMPLETED CANCELLED }

// ============ POSITION-BASED BOOKING ============
model MatchPosition {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamSide     TeamSide @default(HOME)
  position     Position
  jerseyNumber Int
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id])
  isLocked     Boolean  @default(false)
}

enum TeamSide { HOME AWAY }
enum Position { GK CB LB RB CDM CM CAM LM RM LW RW ST CF SS ANY }

model UserPosition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Position
  isPrimary Boolean  @default(false)
}

// ============ BOOKING ============
model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  matchId       String
  match         Match         @relation(fields: [matchId], references: [id])
  status        BookingStatus @default(PENDING_PAYMENT)
  teamSide      TeamSide?
  positionTaken MatchPosition?
  qrCode        String        @unique @default(cuid())
  checkedIn     Boolean       @default(false)
  isNoShow      Boolean       @default(false)
  transaction   Transaction?
  createdAt     DateTime      @default(now())
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_REFUND
  CANCELLED_PENALTY
  COMPLETED
  NO_SHOW
}

// ============ TRANSACTION (Escrow) ============
model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  bookingId   String            @unique
  booking     Booking           @relation(fields: [bookingId], references: [id])
  amount      Decimal           @db.Decimal(12, 2)
  platformFee Decimal           @db.Decimal(12, 2)
  gateway     PaymentGateway    @default(UZUM_PAY)
  gatewayTxId String?
  status      TransactionStatus @default(PENDING)
  heldAt      DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?
  createdAt   DateTime          @default(now())
}

enum PaymentGateway    { UZUM_PAY PAYME CLICK WALLET }
enum TransactionStatus { PENDING HELD RELEASED REFUNDED FAILED PARTIALLY_REFUNDED }

// ============ RATINGS ============
model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId   String
  rated     User     @relation("RatingsReceived", fields: [ratedId], references: [id])
  thumbsUp  Boolean
  comment   String?
  createdAt DateTime @default(now())
  @@unique([matchId, raterId, ratedId])
}

// ============ MESSAGING ============
model Conversation {
  id        String               @id @default(cuid())
  type      ConvType             @default(DIRECT)
  matchId   String?
  members   ConversationMember[]
  messages  Message[]
  createdAt DateTime             @default(now())
}
enum ConvType { DIRECT MATCH_GROUP SUPPORT }

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  isAdmin        Boolean      @default(false)
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readBy         String[]
  createdAt      DateTime     @default(now())
}

// ============ NOTIFICATIONS ============
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  matchId   String?
  match     Match?           @relation(fields: [matchId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  sentVia   String[]
  createdAt DateTime         @default(now())
}

enum NotificationType {
  BOOKING_CONFIRMED
  MATCH_FULL
  MATCH_CONFIRMED
  MATCH_CANCELLED
  SPOT_FREED
  GAME_STARTING_SOON
  RATING_RECEIVED
  PAYMENT_RELEASED
  REFERRAL_BONUS
  ADMIN_ANNOUNCEMENT
}

model PitchFollower {
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  @@id([pitchId, userId])
}

model AppSettings {
  id               String  @id @default("singleton")
  commissionRate   Float   @default(0.10)
  platformFeeRate  Float   @default(0.05)
  updatedAt        DateTime @updatedAt
}
