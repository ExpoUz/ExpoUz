generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USER & AUTH ============
model User {
  id               String      @id @default(cuid())
  phone            String?     @unique
  // Verified phone-number capture (see PhoneVerification). A `phone` value may
  // exist as a non-E.164 placeholder (e.g. "+998000…" derived from telegramId)
  // without being verified — always gate on phoneVerified, never on phone.
  phoneVerified     Boolean            @default(false)
  phoneVerifiedAt   DateTime?
  phoneVerifyMethod PhoneVerifyMethod?
  email            String?     @unique
  passwordHash     String?     // bcrypt hash — set only for email+password admin accounts
  googleId         String?     @unique
  firstName        String
  lastName         String
  avatarUrl        String?
  dateOfBirth      DateTime?
  gender           Gender      @default(MALE)
  bio              String?
  reliabilityScore Float       @default(100.0)
  eloRating        Int         @default(1000)
  skillLevel       SkillLevel  @default(AMATEUR)
  gamesAttended    Int         @default(0)
  gamesThisMonth   Int         @default(0)
  winCount         Int         @default(0)
  playerLevel      PlayerLevel @default(NEW)

  // ---- Skill rating (ELO-style 0.0–7.0 ladder) ----
  // NOTE: these are the PADEL ladder's legacy fields. The padel track now lives
  // on the dedicated padel* fields below; football uses eloRating/skillLevel.
  skillRating        Float          @default(0.0) // legacy/padel — superseded by padelLevel
  levelReliability   Int            @default(0)
  initialLevelSet    Boolean        @default(false)
  matchesPlayed      Int            @default(0) // FOOTBALL match counts
  matchesWon         Int            @default(0)
  matchesLost        Int            @default(0)
  currentStreak      Int            @default(0) // + = win streak, - = loss streak (padel)
  longestWinStreak   Int            @default(0)

  // ---- Padel level track (0.0–7.0 ELO, independent of football) ----
  padelLevel         Float          @default(0.0)
  padelReliability   Int            @default(0) // 0-100% confidence
  padelInitialSet    Boolean        @default(false) // completed padel onboarding
  padelMatchesPlayed Int            @default(0)
  padelMatchesWon    Int            @default(0)
  padelMatchesLost   Int            @default(0)
  bestHand           BestHand?      @default(RIGHT)
  courtPosition      CourtPosition? @default(BOTH)
  preferredMatchType MatchType?     @default(COMPETITIVE)

  role             UserRole  @default(PLAYER)
  language         String    @default("uz") // BCP-47 locale: "uz" | "ru" | "en" (extensible)
  city             String    @default("Tashkent")
  district         String?
  isVerified       Boolean   @default(false)
  telegramId       String?   @unique
  telegramUsername String?
  credit           Decimal   @default(0) @db.Decimal(12, 2)
  referralCode     String    @unique @default(cuid())
  referredBy       String?
  notifPush        Boolean   @default(true)
  notifSms         Boolean   @default(true)
  notifTelegram    Boolean   @default(true)
  isBanned         Boolean   @default(false)
  bannedAt         DateTime?
  bannedReason     String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hostMatches                Match[]                   @relation("HostMatches")
  organizedMatches           Match[]                   @relation("OrganizerMatches")
  bookings                   Booking[]
  transactions               Transaction[]
  ratingsGiven               PlayerRating[]            @relation("RatingsGiven")
  ratingsReceived            PlayerRating[]            @relation("RatingsReceived")
  ownedPitches               Pitch[]                   @relation("PitchOwner")
  messages                   Message[]
  notifications              Notification[]
  preferredPositions         UserPosition[]
  conversationMemberships    ConversationMember[]
  refreshTokens              RefreshToken[]
  pitchBookings              PitchBooking[]            @relation("PitchBookingHost")
  pitchBookingParticipations PitchBookingParticipant[]
  activityLogs               ActivityLog[]
  session                    UserSession?
  levelHistory               LevelHistory[]
  matchResults               MatchResult[]             @relation("PlayerResults")
  walletTransactions         WalletTransaction[]
  phoneVerifications         PhoneVerification[]
}

// ============ PHONE VERIFICATION ============
enum PhoneVerifyMethod {
  TELEGRAM_CONTACT // one-tap share via requestContact (free, no code)
  TELEGRAM_GATEWAY // Telegram Gateway OTP
  SMS              // Eskiz SMS fallback (feature-flagged)
  ADMIN            // manually set by an admin
}

// Short-lived verification attempt. Codes are verified Telegram-side
// (checkVerificationStatus) so codeHash is normally null; it exists only for a
// future self-generated-code path. Rows expire and are single-use.
model PhoneVerification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  requestId String? // Telegram Gateway request_id
  codeHash  String? // bcrypt hash of the code — NEVER store plaintext
  method    PhoneVerifyMethod
  attempts  Int               @default(0)
  verified  Boolean           @default(false)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([phone])
}

// ============ WALLET LEDGER ============
// Immutable, append-only ledger of every wallet movement. `balanceAfter` is the
// running balance at the time of the entry — never update or delete these rows;
// corrections are new ADMIN_ADJUSTMENT entries.
model WalletTransaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         WalletTxType
  amount       Decimal      @db.Decimal(12, 2) // + = credit in, - = debit out
  balanceAfter Decimal      @db.Decimal(12, 2)
  reference    String? // matchId, bookingId, topup id, etc.
  description  String
  createdAt    DateTime     @default(now())

  @@index([userId])
}

enum WalletTxType {
  TOPUP
  MATCH_PAYMENT
  REFUND
  CANCELLATION_FEE
  PAYOUT
  ADMIN_ADJUSTMENT
  REFERRAL_BONUS
  WELCOME_BONUS
}

enum BestHand {
  LEFT
  RIGHT
}

enum CourtPosition {
  FOREHAND
  BACKHAND
  BOTH
}

enum MatchType {
  CASUAL
  COMPETITIVE
}

model LevelHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Float
  reliability Int
  change      Float // +0.12, -0.08, etc.
  matchId     String?
  reason      String // "Won vs higher level", "Lost competitive match", "Initial assessment"
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  PLAYER
  PITCH_OWNER
  ADMIN
  SUPER_ADMIN
}

enum SkillLevel {
  BEGINNER
  AMATEUR
  PRO
}

enum PlayerLevel {
  NEW // 0 games
  ROOKIE // 1-5
  REGULAR // 6-15
  EXPERIENCED // 16-30
  VETERAN // 31-60
  ELITE // 61+
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// ============ PITCH / STADIUM ============
model Pitch {
  id              String          @id @default(cuid())
  ownerId         String
  owner           User            @relation("PitchOwner", fields: [ownerId], references: [id])
  name            String
  description     String?
  addressLine     String
  district        String
  city            String          @default("Tashkent")
  lat             Float
  lng             Float
  hourlyRate      Decimal         @db.Decimal(12, 2)
  photos          String[]
  amenities       Amenity[]
  surfaceType     SurfaceType     @default(ARTIFICIAL)
  pitchSize       PitchSize       @default(SEVEN_A_SIDE)
  isIndoor        Boolean         @default(false)
  isVerified      Boolean         @default(false)
  isActive        Boolean         @default(true)
  noMetalStuds    Boolean         @default(false)
  commission      Float           @default(0.10)
  rejectionReason String?
  // A venue belongs to one sport. Defaults to PADEL to keep existing courts
  // correctly labelled after the padel pivot; football pitches set FOOTBALL.
  sport           Sport           @default(PADEL)
  // Padel court attributes
  courtType       PadelCourtType  @default(PANORAMIC)
  isCovered       Boolean         @default(false)
  locationId      String?
  location        Location?       @relation(fields: [locationId], references: [id])
  createdAt       DateTime        @default(now())
  matches         Match[]
  followers       PitchFollower[]
  pitchBookings   PitchBooking[]
}

enum SurfaceType {
  NATURAL
  ARTIFICIAL
  FUTSAL
  INDOOR_TURF
}

enum PitchSize {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
  SINGLES
  DOUBLES
}

enum PadelCourtType {
  PANORAMIC // full glass walls
  CLASSIC // mixed glass and mesh
  SINGLE // narrower singles court
}

model Amenity {
  id      String      @id @default(cuid())
  pitchId String
  pitch   Pitch       @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  type    AmenityType
}

enum AmenityType {
  BATHROOM
  PARKING
  WATER_FOUNTAIN
  CHANGING_ROOM
  CAFE
  SECURITY
  LIGHTS
}

// ============ MATCH ============
model Match {
  id                        String      @id @default(cuid())
  pitchId                   String
  pitch                     Pitch       @relation(fields: [pitchId], references: [id])
  hostId                    String
  host                      User        @relation("HostMatches", fields: [hostId], references: [id])
  title                     String
  sport                     Sport       @default(PADEL)
  format                    String      @default("2v2")
  startTime                 DateTime
  durationMinutes           Int         @default(60)
  maxPlayers                Int         @default(4)
  minPlayers                Int         @default(2)
  currentPlayers            Int         @default(0)
  pricePerPlayer            Decimal     @db.Decimal(12, 2)
  status                    MatchStatus @default(OPEN)
  isCoEd                    Boolean     @default(true)
  skillFilter               SkillLevel?
  description               String?
  cancellationDeadlineHours Int         @default(5)
  cancellationFeePercent    Int         @default(50)
  telegramTopicId           String?
  formation                 String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  // ---- Booking type ----
  bookingType          BookingType @default(OPEN_EVENT)
  // Group booking (BookingType.GROUP_BOOKING)
  organizerPlayerCount Int?
  organizerTotalPaid   Decimal?    @db.Decimal(12, 2)
  extraSpotsAvailable  Int?
  // Full booking (BookingType.FULL_BOOKING)
  isPrivate            Boolean     @default(false)
  fullBookingHours     Int?
  fullBookingTotalCost Decimal?    @db.Decimal(12, 2)
  // Telegram sharing / invites
  telegramShareLink    String?
  shareCode            String?     @unique
  // Organizer (user who created and paid upfront; may differ from host)
  organizerId          String?
  organizer            User?       @relation("OrganizerMatches", fields: [organizerId], references: [id])

  // ---- Competitive scoring / skill rating ----
  matchType       MatchType @default(COMPETITIVE) // CASUAL or COMPETITIVE
  minLevel        Float? // minimum skill rating to join (e.g. 2.0)
  maxLevel        Float? // maximum skill rating to join (e.g. 3.5)
  resultSubmitted Boolean   @default(false)

  bookings      Booking[]
  positions     MatchPosition[]
  ratings       PlayerRating[]
  notifications Notification[]
  result        MatchResult?
}

model MatchResult {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Padel scoring — best of 3 sets
  team1Set1   Int?
  team2Set1   Int?
  team1Set2   Int?
  team2Set2   Int?
  team1Set3   Int?
  team2Set3   Int?
  winningTeam Int // 1 or 2

  submittedById String
  confirmedBy   String[] // user IDs who confirmed the score
  isDisputed    Boolean  @default(false)
  isConfirmed   Boolean  @default(false)

  players   User[]   @relation("PlayerResults")
  createdAt DateTime @default(now())
}

enum Sport {
  FOOTBALL
  PADEL
  TENNIS
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingType {
  OPEN_EVENT // User creates event, invites others, extra spots available
  GROUP_BOOKING // User pays for N people upfront, invites N people to join
  FULL_BOOKING // User books entire pitch for themselves / private group
}

// ============ POSITION-BASED BOOKING ============
model MatchPosition {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamSide     TeamSide @default(HOME)
  position     Position
  jerseyNumber Int
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id])
  isLocked     Boolean  @default(false)
}

enum TeamSide {
  HOME
  AWAY
}

enum Position {
  GK
  CB
  LB
  RB
  CDM
  CM
  CAM
  LM
  RM
  LW
  RW
  ST
  CF
  SS
  ANY
}

model UserPosition {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Position
  isPrimary Boolean  @default(false)
}

// ============ BOOKING ============
model Booking {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id])
  status        BookingStatus  @default(PENDING_PAYMENT)
  teamSide      TeamSide?
  positionTaken MatchPosition?
  qrCode        String         @unique @default(cuid())
  checkedIn     Boolean        @default(false)
  isNoShow      Boolean        @default(false)
  transaction   Transaction?
  createdAt     DateTime       @default(now())
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_REFUND
  CANCELLED_PENALTY
  COMPLETED
  NO_SHOW
}

// ============ TRANSACTION (Escrow) ============
model Transaction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  bookingId      String?           @unique
  booking        Booking?          @relation(fields: [bookingId], references: [id])
  pitchBookingId String?           @unique
  pitchBooking   PitchBooking?     @relation(fields: [pitchBookingId], references: [id])
  amount         Decimal           @db.Decimal(12, 2)
  platformFee    Decimal           @db.Decimal(12, 2)
  gateway        PaymentGateway    @default(UZUM_PAY)
  gatewayTxId    String?
  status         TransactionStatus @default(PENDING)
  heldAt         DateTime?
  releasedAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime          @default(now())
}

enum PaymentGateway {
  UZUM_PAY
  PAYME
  CLICK
  WALLET
}

enum TransactionStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
  PARTIALLY_REFUNDED
}

// ============ RATINGS ============
model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  raterId   String
  rater     User     @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId   String
  rated     User     @relation("RatingsReceived", fields: [ratedId], references: [id])
  thumbsUp  Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@unique([matchId, raterId, ratedId])
}

// ============ MESSAGING ============
model Conversation {
  id              String               @id @default(cuid())
  type            ConvType             @default(DIRECT)
  matchId         String?
  pitchBookingId  String?              @unique
  telegramTopicId String?
  telegramChatId  String?
  members         ConversationMember[]
  messages        Message[]
  pitchBooking    PitchBooking?        @relation(fields: [pitchBookingId], references: [id])
  createdAt       DateTime             @default(now())
}

enum ConvType {
  DIRECT
  MATCH_GROUP
  PITCH_HIRE
  SUPPORT
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  isAdmin        Boolean      @default(false)
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readBy         String[]
  createdAt      DateTime     @default(now())
}

// ============ NOTIFICATIONS ============
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  matchId   String?
  match     Match?           @relation(fields: [matchId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  sentVia   String[]
  createdAt DateTime         @default(now())
}

enum NotificationType {
  BOOKING_CONFIRMED
  MATCH_FULL
  MATCH_CONFIRMED
  MATCH_CANCELLED
  SPOT_FREED
  GAME_STARTING_SOON
  RATING_RECEIVED
  PAYMENT_RELEASED
  REFERRAL_BONUS
  ADMIN_ANNOUNCEMENT
  CANCELLATION_WINDOW_CLOSING
  INVITE_JOINED
}

model PitchFollower {
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([pitchId, userId])
}

model AppSettings {
  id                      String   @id @default("singleton")
  commissionRate          Float    @default(0.10)
  platformFeeRate         Float    @default(0.05)
  cancellationFeeRate     Float    @default(0.50)
  cancellationWindowHours Int      @default(5)
  updatedAt               DateTime @updatedAt
}

// ============ DIRECT PITCH BOOKING ============
// Allows booking a pitch for 1+ hours as a group hire or open-join session,
// independent of a structured match with formations.
model PitchBooking {
  id                        String                    @id @default(cuid())
  pitchId                   String
  pitch                     Pitch                     @relation(fields: [pitchId], references: [id])
  hostId                    String
  host                      User                      @relation("PitchBookingHost", fields: [hostId], references: [id])
  title                     String
  type                      PitchBookingType          @default(GROUP_HIRE)
  startTime                 DateTime
  durationHours             Int                       @default(1)
  totalPrice                Decimal                   @db.Decimal(12, 2)
  pricePerParticipant       Decimal?                  @db.Decimal(12, 2)
  maxParticipants           Int?
  status                    PitchBookingStatus        @default(PENDING_PAYMENT)
  cancellationDeadlineHours Int                       @default(5)
  cancellationFeeRate       Float                     @default(0.50)
  notes                     String?
  telegramTopicId           String?
  conversation              Conversation?
  participants              PitchBookingParticipant[]
  transaction               Transaction?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

enum PitchBookingType {
  GROUP_HIRE // One person books the whole pitch, no individual joining
  OPEN_JOIN // Book a pitch, open slots for others to join and share cost
}

enum PitchBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED_REFUND
  CANCELLED_PENALTY
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

model PitchBookingParticipant {
  id         String            @id @default(cuid())
  bookingId  String
  booking    PitchBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  status     ParticipantStatus @default(CONFIRMED)
  paidAmount Decimal?          @db.Decimal(12, 2)
  joinedAt   DateTime          @default(now())

  @@unique([bookingId, userId])
}

enum ParticipantStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
}

// ============ LOCATION ============
// Geographic zones used to organise pitches under Super Admin hierarchy
model Location {
  id        String   @id @default(cuid())
  name      String
  city      String
  district  String?
  lat       Float?
  lng       Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pitches   Pitch[]
}

// ============ ACTIVITY LOG ============
// Immutable audit trail: every admin/super-admin action is recorded here
model ActivityLog {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  action      String // e.g. "BAN_USER", "VERIFY_PITCH", "MATCH_JOINED"
  category    ActivityCategory? // typed classification for user-facing activity feeds
  description String? // human-readable summary shown in history feeds
  entityType  String? // e.g. "User", "Pitch", "Match"
  entityId    String?
  meta        Json? // arbitrary payload snapshot
  ipAddress   String?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([category])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ActivityCategory {
  REGISTERED
  LOGIN
  PROFILE_UPDATED
  MATCH_CREATED
  MATCH_JOINED
  MATCH_LEFT
  MATCH_CANCELLED
  PAYMENT_INITIATED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  INVITE_SENT
  INVITE_ACCEPTED
  RATING_GIVEN
  RATING_RECEIVED
  ADMIN_ACTION
}

// ============ USER SESSION (online presence) ============
// Updated on every authenticated API request via middleware
model UserSession {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  deviceInfo String?
  ipAddress  String?
  updatedAt  DateTime @updatedAt
}
